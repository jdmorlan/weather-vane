<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Only what INFOPLIST_KEY_ build settings cannot say. Everything else is
  generated (GENERATE_INFOPLIST_FILE) and merged over this. Shared by all three
  apps; see VANE_URL_SCHEME in project.yml for why the scheme is a variable.
-->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(VANE_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
